# BidMonitor 敏感配置文件
# 复制此文件为 .env 并填入真实值
# .env 不会被 Git 跟踪，确保敏感信息不会泄露

# ========================
# AI 配置
# ========================
DEEPSEEK_API_KEY=your-api-key-here

# ========================
# 邮箱配置（SMTP 授权码）
# ========================
EMAIL_SMTP_PASSWORD=your-email-auth-code

# ========================
# 短信配置（阿里云）
# ========================
SMS_ACCESS_KEY_SECRET=your-access-key-secret

# ========================
# 语音配置（阿里云）
# ========================
VOICE_ACCESS_KEY_SECRET=your-access-key-secret
